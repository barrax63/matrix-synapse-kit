# ---- General Settings ----
TZ=UTC
UID=1000
GID=1000

# ---- PostgreSQL Database ----
POSTGRES_USER=synapse
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Note: POSTGRES_DB is not set because the synapse database is created
# explicitly in postgres-init/01-init-postgres.sql with template0 to ensure
# correct collation settings as required by Synapse

# ---- Synapse Matrix Server ----
# Your Matrix server's public domain (e.g., matrix.example.com)
SYNAPSE_SERVER_NAME=matrix.example.com

# Whether to report anonymous usage statistics to Matrix.org
# Options: yes | no
SYNAPSE_REPORT_STATS=no

# ---- Cloudflare Tunnel ----
# Obtain from: https://one.dash.cloudflare.com/ -> Zero Trust -> Networks -> Tunnels
CLOUDFLARED_TUNNEL_TOKEN=
